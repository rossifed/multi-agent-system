# Agent Platform - Phase 0 configuration
# Copy to .env and adjust. All values have safe defaults; nothing here is secret.
# NOTE: This service drives the local `claude` CLI, which authenticates via the
# Claude subscription (Max) OAuth credentials already stored on the host/container.
# It does NOT require ANTHROPIC_API_KEY and does NOT consume API credits.

# --- Claude CLI backend ---
# Path to the claude executable (must be on PATH inside the container).
AGENT_CLAUDE_BINARY=claude
# Hard timeout for a single claude invocation, in seconds.
AGENT_CLAUDE_TIMEOUT_SECONDS=120
# Optional model override passed to `claude --model`. Leave empty for CLI default.
AGENT_CLAUDE_MODEL=
# Backend implementation: "cli" (real subprocess) or "mock" (canned responses, for demos/tests).
AGENT_BACKEND=cli

# --- Claude capabilities (full power) ---
# Permission mode passed to `claude --permission-mode`.
#   ""                  -> CLI default (tools requiring approval are blocked in headless mode)
#   "bypassPermissions" -> FULL POWER: the agent runs any command / writes any file with no
#                          approval, exactly like a local terminal session.
# SECURITY: only enable "bypassPermissions" behind our own authentication AND a scoped
# workspace (below). It is the product's intended mode, but it is dangerous if exposed.
AGENT_CLAUDE_PERMISSION_MODE=bypassPermissions
# Directory the agent works in and is granted access to (--add-dir + subprocess cwd).
# Scopes file access so the agent cannot roam the whole container filesystem.
AGENT_CLAUDE_WORKSPACE_DIR=./data/workspace
# Optional space-separated tool allowlist (--allowedTools). Empty = all tools allowed
# (subject to the permission mode above). e.g. "Bash Read Write Edit WebFetch".
AGENT_CLAUDE_ALLOWED_TOOLS=

# --- Session persistence ---
# JSON file where session state is persisted. Empty disables persistence (in-memory only).
AGENT_SESSION_STORE_PATH=./data/sessions.json

# --- API authentication (our own layer) ---
# Shared secret required on every request except /health, sent as
# "Authorization: Bearer <key>" or "X-API-Key: <key>". Empty = UNAUTHENTICATED
# (local dev only; logs a warning). MUST be set before any public deployment.
# Generate one with: openssl rand -base64 32
AGENT_GATEWAY_API_KEY=

# --- API / server ---
AGENT_LOG_LEVEL=INFO
# Pretty (human) logs for local dev, JSON logs for production.
AGENT_LOG_JSON=false
# Comma-separated list of allowed CORS origins for the web UI.
AGENT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
